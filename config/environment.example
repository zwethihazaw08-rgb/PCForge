# Configure these in Apache/PHP environment settings on the host.
# Do not rename this file to .env: the application reads environment variables,
# not files in the public project directory.

PCFORGE_GOOGLE_CLIENT_ID=
PCFORGE_GOOGLE_CLIENT_SECRET=
PCFORGE_GOOGLE_REDIRECT_URI=http://localhost/PCForge/auth/google-callback.php

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Use a hostname reachable from a phone for receipt QR codes.
# Example: http://192.168.10.105/PCForge
PCFORGE_PUBLIC_URL=
