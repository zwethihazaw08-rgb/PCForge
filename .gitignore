# Local image-processing runtime and model cache (not needed to run the PHP site).
.tools/

# Database exports contain accounts, orders, and other private records.
Database/backups/*
!Database/backups/.htaccess
Database/pcforge.sql

# Local environment and secret files.
.env
.env.*
!.env.example
config/oauth.local.php

# OS/editor noise.
.DS_Store
Thumbs.db
*.swp

# Original sources and one-time preparation tools stay on the maintainer's PC.
ProductsData/
Database/import_products_data.php
Database/prepare_products_data.py
Database/remove_product_backgrounds.py
Database/products_data.json
Database/product_image_overrides.json
Database/seed_dashboard.php
tests/product-images.py

# New installs use only the schema and public catalog seed.
Database/*.sql
!Database/schema.sql
!Database/catalog.sql
Database/migrations/

